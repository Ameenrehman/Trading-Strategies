# Angel One SmartAPI Credentials
# Copy this file to .env and fill in your details.
# .env is gitignored - never commit real credentials.

# 1. API Key generated from smartapi.angelbroking.com dashboard
SMARTAPI_API_KEY=your_api_key_here

# 2. Your Angel One Client Code (e.g., A123456)
SMARTAPI_CLIENT_CODE=your_client_code_here

# 3. Your Angel One MPIN (or Password)
SMARTAPI_PIN=your_mpin_here

# 4. Your TOTP Secret Key (Base32 string shown when setting up TOTP / QR code)
# If provided, the script will automatically generate 6-digit TOTP codes with pyotp
SMARTAPI_TOTP_SECRET=your_totp_secret_key_here
